{
  "appId": "com.akashdeepkrishi.agriadvisor",
  "appName": "AKASHDEEP KRISHI LLP",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#003622",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
